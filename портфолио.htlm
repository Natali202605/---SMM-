</div>

<!-- ===== HERO ===== -->
<section class="hero" id="hero">
    <div class="hero-bg">
        <div class="morph-shape morph-1"></div>
        <div class="morph-shape morph-2"></div>
        <div class="morph-shape morph-3"></div>
    </div>
    <div class="hero-grid-pattern"></div>
    <div class="particles" id="particles"></div>

    <div class="hero-content">
        <div class="hero-text">
            <div class="hero-badge">
                <span class="pulse-dot"></span>
                Открыта к новым проектам
            </div>
            <h1 class="hero-title">
                <span class="line">Натали</span>
                <span class="line gradient-text">Смирнова</span>
            </h1>
            <div class="hero-typing" id="heroTyping"></div>
            <p class="hero-subtitle">
                SMM-специалист с экспертизой в AI-контенте. Создаю стратегию, контент и автоматизацию, которые превращают подписчиков в клиентов.
            </p>
            <div class="hero-actions">
                <a href="#cases" class="btn btn-primary">
                    Смотреть кейсы
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
                </a>
                <a href="#contact" class="btn btn-secondary">
                    Обсудить проект
                </a>
            </div>
            <div class="hero-stats">
                <div class="hero-stat">
                    <div class="hero-stat-number counter" data-target="4">0</div>
                    <div class="hero-stat-label">Сертификата</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-number counter" data-target="136">0</div>
                    <div class="hero-stat-label">Уроков пройдено</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-number">1+</div>
                    <div class="hero-stat-label">Год опыта</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-number counter" data-target="500">0</div>
                    <div class="hero-stat-label">K контента</div>
                </div>
            </div>
        </div>
        <div class="hero-visual">
            <div class="hero-photo-wrapper" id="heroPhotoCard">
                <div class="hero-photo-card">
                    <!-- Photo 2 - Portrait on main page -->
                    <img class="hero-photo-img" src="gallery/photo-portrait.png" alt="Натали Смирнова — SMM специалист">
                    <div class="hero-photo-overlay">
                        <div>
                            <div class="hero-photo-name">Натали Смирнова</div>
                            <div class="hero-photo-role">SMM & AI Content Specialist</div>
                            <div class="hero-photo-badges">
                                <span class="photo-badge" style="background: rgba(131,58,180,0.15); color: #c084fc;">Midjourney PRO</span>
                                <span class="photo-badge" style="background: rgba(0,212,255,0.15); color: #00d4ff;">Нейровидео</span>
                                <span class="photo-badge" style="background: rgba(0,255,136,0.15); color: #00ff88;">AI-боты</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Floating elements -->
            <div class="float-element float-el-1">
                <div class="float-pill">
                    <div class="float-pill-icon" style="background: rgba(225,48,108,0.15);">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#E1306C" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    </div>
                    <div>
                        <div class="float-pill-value">+280%</div>
                        <div class="float-pill-label">Вовлечённость</div>
                    </div>
                </div>
            </div>
            <div class="float-element float-el-2">
                <div class="float-pill">
                    <div class="float-pill-icon" style="background: rgba(0,255,136,0.15);">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#00ff88" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                    </div>
                    <div>
                        <div class="float-pill-value">AI-Powered</div>
                        <div class="float-pill-label">Контент</div>
                    </div>
                </div>
            </div>
            <div class="float-element float-el-3">
                <div class="float-pill">
                    <div class="float-pill-icon" style="background: rgba(252,175,69,0.15);">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#FCAF45" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </div>
                    <div>
                        <div class="float-pill-value">4</div>
                        <div class="float-pill-label">Сертификата</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== ABOUT ===== -->
<section class="about" id="about">
    <div class="section-container">
        <div class="about-grid">
            <div class="about-visual reveal-left">
                <div class="about-photo">
                    <img src="gallery/photo-portrait.png" alt="Натали Смирнова">
                    <div class="about-photo-overlay"></div>
                </div>
                <div class="about-exp-circle">
                    <div class="exp-num">1+</div>
                    <div class="exp-label">год опыта</div>
                </div>
            </div>
            <div class="about-content reveal-right">
                <div class="section-label">О себе</div>
                <h3>Стратегия × Креатив × AI-технологии</h3>
                <p>
                    Привет! Я Натали Евгеньевна Смирнова — SMM-специалист, увлечённая миром digital-маркетинга и искусственного интеллекта. За свой первый год работы я уже помогла брендам выстроить эффективное присутствие в социальных сетях, используя <span class="highlight-text">современные AI-инструменты</span> для создания контента.
                </p>
                <p>
                    Мой уникальный подход — это сочетание классического SMM с нейровидео, нейроизображениями и чат-ботами. Это позволяет создавать контент быстрее, дешевле и эффективнее.
                </p>
                <p>
                    В будущем планирую освоить <span class="highlight-text">вайб-кодинг</span> для ещё более глубокой интеграции в digital-среду.
                </p>

                <div class="certs-mini-grid">
                    <div class="cert-mini-item">
                        <div class="cert-mini-icon" style="background: rgba(131,58,180,0.12);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#833AB4" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                        </div>
                        <div class="cert-mini-info">
                            <h4>Midjourney PRO</h4>
                            <p>24 урока · Нейроизображения</p>
                        </div>
                    </div>
                    <div class="cert-mini-item">
                        <div class="cert-mini-icon" style="background: rgba(0,212,255,0.12);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#00d4ff" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                        </div>
                        <div class="cert-mini-info">
                            <h4>Нейровидео PRO</h4>
                            <p>20 уроков · AI-видео</p>
                        </div>
                    </div>
                    <div class="cert-mini-item">
                        <div class="cert-mini-icon" style="background: rgba(0,255,136,0.12);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#00ff88" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        </div>
                        <div class="cert-mini-info">
                            <h4>GPT-агенты и AI-боты</h4>
                            <p>26 уроков · Чат-боты</p>
                        </div>
                    </div>
                    <div class="cert-mini-item">
                        <div class="cert-mini-icon" style="background: rgba(225,48,108,0.12);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#E1306C" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                        </div>
                        <div class="cert-mini-info">
                            <h4>Нейросети для SMM</h4>
                            <p>66 уроков · Промпт-инженер</p>
                        </div>
                    </div>
                </div>

                <div class="future-tag">
                    <span class="sparkle">✨</span>
                    В перспективе: вайб-кодинг
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== SKILLS ===== -->
<section class="skills" id="skills">
    <div class="section-container">
        <div class="section-header reveal">
            <div class="section-label">Навыки</div>
            <h2 class="section-title">Ключевые компетенции</h2>
            <p class="section-desc">Полный спектр навыков для создания эффективной SMM-стратегии с использованием AI-технологий</p>
        </div>
        <div class="skills-grid">
            <div class="skill-card reveal delay-1">
                <div class="skill-icon" style="background: rgba(225,48,108,0.12);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#E1306C" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </div>
                <h3>SMM-стратегия</h3>
                <p>Разработка комплексных стратегий продвижения в социальных сетях, ориентированных на бизнес-цели</p>
                <div class="skill-tags">
